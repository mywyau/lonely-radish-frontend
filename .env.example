SITE_URL=http://localhost:3000
APP_ENV=development

# Required in staging. Comma-separated exact recipients; all other email is suppressed.
STAGING_EMAIL_ALLOWLIST=

# Optional OpenTelemetry export. OTLP keeps the app independent of any one
# monitoring vendor. The base endpoint receives both /v1/traces and /v1/metrics.
# Use OTEL_EXPORTER_OTLP_METRICS_ENDPOINT when your vendor supplies a separate
# metrics URL; unlike the base endpoint, it must include /v1/metrics.
OTEL_SERVICE_NAME=lonely-radish
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRIC_EXPORT_INTERVAL=30000

# Production startup is fail-closed: every production feature below must have
# real credentials. Placeholder values are rejected.

# Auth0 Regular Web Application credentials (server-side only)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Use an independent random value of at least 32 characters in production.
# The app temporarily falls back to AUTH0_CLIENT_SECRET when this is omitted.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Signs short-lived, single-use business offer codes. Generate a separate
# random value of at least 32 bytes and keep it server-side.
OFFER_CLAIM_SECRET=replace-with-an-independent-random-secret

# Optional: for a separately registered Auth0 API.
AUTH0_AUDIENCE=

# Auth0 Management API machine-to-machine application. Grant delete:users.
AUTH0_MGMT_CLIENT_ID=your-management-client-id
AUTH0_MGMT_CLIENT_SECRET=your-management-client-secret
AUTH0_MGMT_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/

# Upstash QStash runs account deletion outside the request lifecycle.
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Shared rate limits and ephemeral cache state. Optional for local development;
# without these values the app uses a process-local in-memory implementation.
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
ACCOUNT_ACCESS_CACHE_ENABLED=true

# PostgreSQL connection used only by the Nuxt server. For serverless production,
# use your provider's transaction-pooler URL and require TLS.
DATABASE_URL=postgresql://user:password@host:6543/database?sslmode=require
# Per-function-instance client pool. Increase only after checking transaction-
# pooler client and backend-connection headroom. The application default is 2.
DATABASE_POOL_MAX=2

# Supabase Storage. The service-role key is server-side only; never expose it
# with a NUXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side postcode geocoding. Never expose this with a NUXT_PUBLIC_ prefix.
OPENCAGE_API_KEY=your-opencage-key

# Transactional email. Keep the API key server-side.
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=Lonely Radish <notifications@updates.lonelyradish.app>
EMAIL_REPLY_TO=contact@lonelyradish.app
APP_BASE_URL=http://localhost:3000

# Stripe subscriptions. Create recurring monthly, three-month, and yearly Prices for the same Product.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ID_QUARTERLY=price_your-three-month-price-id
STRIPE_PRICE_ID_YEARLY=price_your-yearly-price-id

# Business venue subscriptions. Create separate recurring monthly Prices.
STRIPE_BUSINESS_PRICE_ID_STANDARD=price_your-business-standard-price-id
STRIPE_BUSINESS_PRICE_ID_FEATURED=price_your-business-featured-price-id
